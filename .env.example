# Copy to .env and fill in. .env is gitignored and never committed.
#
# Without this file a clean clone had no way of knowing these variables exist, and nothing
# failed usefully: API_URL simply came through as undefined, axios fell back to relative paths,
# and every request 404'd against nothing in particular.

# Base address of the Raphael API, INCLUDING the /api segment.
#
#   DEV   https://app-raphael-dev-scus.azurewebsites.net/api
#   PROD  https://api.raphaeldh.com/api
#
# ⚠️ This only matters for `npx expo start` on your own machine. A build made with EAS takes
# the address from the `env` block of the profile in eas.json, so `--profile preview` goes to
# DEV and `--profile production` goes to PROD, whatever this file says. Doctrine:
# _meta/CLIENT_CONFIG_POLICY.md
#
# ⚠️ PROD is the custom domain and never the Azure host: with the domain, moving the backend is
# a CNAME change; with the Azure host it is a new build for every tester.
API_URL=https://app-raphael-dev-scus.azurewebsites.net/api

# Browser/Android key for Google Maps. Restricted to the com.raphael.rider package plus its
# SHA-1 fingerprint, which is what protects it -- it has to reach the device to work at all.
GOOGLE_MAPS_API_KEY=

# Path to the Firebase service file. EAS overrides this with a secret file; locally it is
# usually the default below, which is gitignored.
GOOGLE_SERVICES_JSON=./google-services.json
