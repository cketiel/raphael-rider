{
  "cli": {
    "version": ">= 21.4.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "API_URL": "https://app-raphael-dev-scus.azurewebsites.net/api"
      }
    },
    "preview": {
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "distribution": "internal"
      },
      "env": {
        "API_URL": "https://app-raphael-dev-scus.azurewebsites.net/api"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "API_URL": "https://api.raphaeldh.com/api"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
